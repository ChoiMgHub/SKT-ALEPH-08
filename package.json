{
  "name": "skt-aleph-08",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev --ip localhost",
    "deploy": "wrangler deploy",
    "setup:local": "node scripts/setup-local.mjs",
    "db:local": "wrangler d1 execute aleph-profile-08 --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute aleph-profile-08 --remote --file=./schema.sql",
    "test": "node --test --test-concurrency=1",
    "evidence:build": "npm run build && node scripts/generate-evidence.mjs",
    "verify:remote": "node scripts/verify-remote.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "miniflare": "5.20261023.0-beta",
    "wrangler": "4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
